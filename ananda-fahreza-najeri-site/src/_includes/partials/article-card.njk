<article class="article-card" data-article-card data-category="{{ (article.data.category or 'Lainnya') | lower }}" data-search="{{ article.data.title }} {{ article.data.description }} {{ article.data.abstract }} {{ article.data.category }} {{ (article.data.tags or []) | join(' ') }} {{ (article.data.keywords or []) | join(' ') }}">
  {% if article.data.featuredImage %}
    <a class="article-card-image" href="{{ article.url }}" tabindex="-1" aria-hidden="true">
      <img src="{{ article.data.featuredImage }}" alt="{{ article.data.featuredImageAlt or '' }}" loading="lazy" width="640" height="360">
    </a>
  {% endif %}
  <div class="article-card-content">
    <div class="article-card-meta">
      <span class="category-label">{{ article.data.category or 'Karya tulis' }}</span>
      <time datetime="{{ article.date | dateISO }}">{{ article.date | formatDate }}</time>
    </div>
    <h3><a href="{{ article.url }}">{{ article.data.title }}</a></h3>
    <p>{{ (article.data.description or article.data.abstract or 'Baca karya tulis selengkapnya.') | excerpt(170) }}</p>
    <a class="text-link" href="{{ article.url }}">Baca tulisan</a>
  </div>
</article>
