---
permalink: /sitemap.xml
layout: false
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url><loc>{{ (site.url ~ '/') | xmlEscape }}</loc></url>
  <url><loc>{{ (site.url ~ '/profil/') | xmlEscape }}</loc></url>
  <url><loc>{{ (site.url ~ '/karya/') | xmlEscape }}</loc></url>
  {% for article in collections.publishedArticles %}
  <url><loc>{{ (site.url ~ article.url) | xmlEscape }}</loc><lastmod>{{ article.date | dateISO }}</lastmod></url>
  {% endfor %}
</urlset>
