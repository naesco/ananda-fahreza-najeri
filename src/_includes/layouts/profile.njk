<main id="konten-utama" class="profile-page">
  <section class="page-hero profile-hero">
    <div class="container page-hero-inner">
      <p class="eyebrow"><span class="eyebrow-rule" aria-hidden="true"></span> Profil penulis</p>
      <h1>{{ site.author.name }}</h1>
      <p class="page-hero-intro">Profil profesional dan ruang pengenalan penulis. Informasi di halaman ini dilengkapi berdasarkan data yang terverifikasi.</p>
    </div>
  </section>
  <section class="section profile-detail-section">
    <div class="container profile-detail-grid">
      <div class="profile-main-column">
        <section class="profile-block" aria-labelledby="bio-heading">
          <p class="eyebrow">01 / Perkenalan</p>
          <h2 id="bio-heading">Tentang penulis</h2>
          <p class="profile-bio">{{ bio or 'Biografi belum ditambahkan.' }}</p>
          {% if content and content | trim %}<div class="prose profile-extra">{{ content | safe }}</div>{% endif %}
        </section>
        <section class="profile-block" aria-labelledby="interest-heading">
          <p class="eyebrow">02 / Fokus</p>
          <h2 id="interest-heading">Bidang minat</h2>
          {% if interests and (interests | length) %}
            <ul class="interest-list">{% for interest in interests %}<li>{{ interest }}</li>{% endfor %}</ul>
          {% else %}
            <p class="muted-copy">Bidang minat akan ditambahkan setelah dikonfirmasi.</p>
          {% endif %}
        </section>
      </div>
      <aside class="profile-sidebar" aria-labelledby="professional-heading">
        <div class="profile-sidebar-top"><img src="/assets/images/monogram.svg" width="58" height="58" alt=""></div>
        <h2 id="professional-heading">Informasi profesional</h2>
        <dl class="profile-facts">
          <div><dt>Pendidikan</dt><dd>{{ education or 'Belum ditambahkan' }}</dd></div>
          <div><dt>Pengalaman</dt><dd>{{ experience or 'Belum ditambahkan' }}</dd></div>
          {% if professional_url %}<div><dt>Profil profesional</dt><dd><a href="{{ professional_url }}" target="_blank" rel="noopener noreferrer">Buka tautan</a></dd></div>{% endif %}
        </dl>
        <p class="profile-sidebar-note">Informasi yang belum tersedia sengaja tidak diasumsikan atau dikarang.</p>
        <a class="text-link" href="/karya/">Lihat karya tulis</a>
      </aside>
    </div>
  </section>
  <section class="profile-cta-section">
    <div class="container profile-cta">
      <div><p class="eyebrow">Publikasi</p><h2>Mulai dari karya yang sudah terbit.</h2></div>
      <a class="button button-primary" href="/karya/">Jelajahi arsip</a>
    </div>
  </section>
</main>
